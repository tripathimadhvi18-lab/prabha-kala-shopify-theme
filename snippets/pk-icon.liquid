{%- doc -%}
  Prabha Kala outline icons (same shapes as the production storefront's lucide icons).

  @param {string} name - menu | close | search | heart | bag | arrow-up-right | sliders | chevron-down | chevron-left | chevron-right
  @param {string} [class] - extra classes
{%- enddoc -%}
{%- liquid
  assign icon_class = 'pk-icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
<svg
  class="{{ icon_class }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'menu' -%}
      <path d="M4 6h16M4 12h16M4 18h16"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18M6 6l12 12"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'heart' -%}
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
    {%- when 'bag' -%}
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17 17 7M7 7h10v10"/>
    {%- when 'sliders' -%}
      <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>
  {%- endcase -%}
</svg>
