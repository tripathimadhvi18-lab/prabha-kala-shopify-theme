{%- comment -%}
  Prabha Kala header shell (foundation phase).
  - Visual reference: production header (sticky ivory bar, Playfair wordmark, tracked uppercase nav).
  - Search opens Horizon's predictive-search modal (rendered once in layout/theme.liquid).
  - The bag opens Horizon's cart drawer; the count is Horizon's <cart-icon> + cart-bubble.
  - Catalogue-driven By Fabric / Craft / Occasion menus are added in a later phase.
{%- endcomment -%}

<script type="module" src="{{ 'cart-icon.js' | asset_url }}" fetchpriority="low"></script>

{%- liquid
  assign wishlist_page = section.settings.wishlist_page
-%}

<header class="pk-header" data-testid="pk-header">
  <div class="pk-container pk-header__bar">
    <details class="pk-header__mobile" data-testid="pk-mobile-menu">
      <summary class="pk-header__icon-button pk-focus" aria-label="Menu">
        <span class="pk-header__icon-open">{%- render 'pk-icon', name: 'menu' -%}</span>
        <span class="pk-header__icon-close">{%- render 'pk-icon', name: 'close' -%}</span>
      </summary>
      <div class="pk-header__panel" data-testid="pk-mobile-menu-panel">
        {%- if section.settings.show_search -%}
          <button type="button" class="pk-header__panel-search pk-focus" on:click="#search-modal/showDialog">
            {%- render 'pk-icon', name: 'search' -%}
            <span>{{ section.settings.search_placeholder }}</span>
          </button>
        {%- endif -%}
        <nav aria-label="Main">
          <ul class="pk-header__panel-links" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.link | default: '#' }}"
                  class="pk-header__panel-link pk-focus{% if block.settings.emphasis %} pk-header__link--emphasis{% endif %}"
                >
                  {{- block.settings.label | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>
    </details>

    <a href="{{ routes.root_url }}" class="pk-header__brand pk-focus" data-testid="pk-brand">
      <span class="pk-header__wordmark pk-heading">{{ shop.name | escape }}</span>
      {%- if section.settings.tagline != blank -%}
        <span class="pk-header__tagline pk-overline">{{ section.settings.tagline | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="pk-header__nav" aria-label="Main">
      <ul class="pk-header__links" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="pk-header__link pk-focus{% if block.settings.emphasis %} pk-header__link--emphasis{% endif %}"
            >
              {{- block.settings.label | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- if section.settings.show_search -%}
      <button
        type="button"
        class="pk-header__search pk-focus"
        on:click="#search-modal/showDialog"
        aria-haspopup="dialog"
        aria-controls="search-modal"
        data-testid="pk-header-search"
      >
        {%- render 'pk-icon', name: 'search', class: 'pk-header__search-icon' -%}
        <span>{{ section.settings.search_placeholder }}</span>
      </button>
    {%- endif -%}

    <div class="pk-header__actions">
      {%- if section.settings.show_search -%}
        <button
          type="button"
          class="pk-header__icon-button pk-header__search-mobile pk-focus"
          on:click="#search-modal/showDialog"
          aria-label="Search"
          aria-haspopup="dialog"
          aria-controls="search-modal"
        >
          {%- render 'pk-icon', name: 'search' -%}
        </button>
      {%- endif -%}

      {%- if wishlist_page != blank -%}
        <a href="{{ wishlist_page.url }}" class="pk-header__icon-button pk-focus" aria-label="Wishlist">
          {%- render 'pk-icon', name: 'heart' -%}
        </a>
      {%- endif -%}

      <button
        type="button"
        class="pk-header__icon-button pk-header__bag pk-focus"
        on:click="#cart-drawer/toggle"
        aria-haspopup="dialog"
        aria-controls="cart-drawer"
        aria-label="Open bag"
        data-testid="pk-bag-button"
      >
        <cart-icon class="pk-header__cart-icon">
          {%- render 'pk-icon', name: 'bag' -%}
          {%- render 'cart-bubble', limit: 99 -%}
        </cart-icon>
      </button>
    </div>
  </div>
</header>

{% stylesheet %}
  .pk-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgb(230 222 200 / 0.8);
    background-color: rgb(250 247 242 / 0.92);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  /* 44px icon buttons + 8px padding + 1px border = 61px, matching production */
  .pk-header__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .pk-header__brand {
    flex-shrink: 0;
    text-decoration: none;
    color: var(--pk-maroon);
  }

  .pk-header__wordmark {
    display: block;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--pk-maroon);
  }

  .pk-header__tagline {
    display: none;
    margin-top: 0.125rem;
    font-size: 0.5625rem;
  }

  .pk-header__nav {
    display: none;
    margin-left: 1.5rem;
  }

  .pk-header__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pk-header__link {
    padding-block: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--pk-ink);
    transition: color 0.2s;
  }

  .pk-header__link:hover {
    color: var(--pk-maroon);
  }

  .pk-header__link--emphasis {
    color: var(--pk-red);
  }

  .pk-header__search {
    display: none;
    align-items: center;
    gap: 0.5rem;
    width: 16rem;
    height: 2.25rem;
    margin-left: auto;
    padding: 0 0.75rem;
    border: 1px solid var(--pk-border);
    background: var(--pk-white);
    color: var(--pk-soft);
    font-family: var(--pk-font-body);
    font-size: 0.875rem;
    text-align: left;
    cursor: text;
  }

  .pk-header__search-icon {
    width: 1rem;
    height: 1rem;
  }

  .pk-header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .pk-header__icon-button {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--pk-ink);
    cursor: pointer;
    list-style: none;
  }

  .pk-header__icon-button::-webkit-details-marker {
    display: none;
  }

  .pk-header__cart-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    --cart-bubble-background: var(--pk-maroon);
    --cart-bubble-text: var(--pk-white);
  }

  .pk-header__cart-icon .cart-bubble {
    position: absolute;
    top: -0.375rem;
    right: -0.5rem;
  }

  /* Mobile menu (below 1024px) */
  .pk-header__mobile {
    position: static;
  }

  .pk-header__icon-close,
  .pk-header__mobile[open] .pk-header__icon-open {
    display: none;
  }

  .pk-header__mobile[open] .pk-header__icon-close {
    display: block;
  }

  .pk-header__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-top: 1px solid var(--pk-border);
    background: var(--pk-white);
    padding: 0.75rem var(--pk-gutter) 1.25rem;
  }

  .pk-header__panel-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    height: 2.5rem;
    margin-bottom: 1rem;
    padding: 0 0.75rem;
    border: 1px solid var(--pk-border);
    background: var(--pk-white);
    color: var(--pk-soft);
    font-size: 0.875rem;
    text-align: left;
  }

  .pk-header__panel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pk-header__panel-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--pk-border);
    font-size: 0.75rem;
    text-decoration: none;
    color: var(--pk-muted);
  }

  @media (min-width: 640px) {
    .pk-header__tagline {
      display: block;
    }

    /* With the tagline visible, production's header is 63px */
    .pk-header__bar {
      padding-block: 0.5625rem;
    }
  }

  @media (min-width: 768px) {
    .pk-header__search {
      display: flex;
    }

    .pk-header__search-mobile {
      display: none;
    }

    .pk-header__actions {
      margin-left: 0.5rem;
    }
  }

  @media (min-width: 1024px) {
    .pk-header__mobile {
      display: none;
    }

    .pk-header__nav {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PK header",
  "class": "pk-header-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under the wordmark",
      "default": "Handwoven since the loom"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search sarees, crafts…"
    },
    {
      "type": "page",
      "id": "wishlist_page",
      "label": "Wishlist page (icon shows only when set)"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All sarees"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "emphasis",
          "label": "Highlight (e.g. New in)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "PK header"
    }
  ]
}
{% endschema %}
