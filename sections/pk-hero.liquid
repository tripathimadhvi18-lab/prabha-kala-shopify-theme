{%- comment -%}
  Prabha Kala hero (port of the production P2h-A HeroCarousel).
  Slides: active "hero_slide" metaobject entries, ordered by sort_order then handle.
  TEMPORARY FALLBACK: when there are no active entries, the section's fallback slide
  blocks are shown (the same built-in slides as production). Remove once
  Shopify-managed slides are in use.
  Only the current slide is in the live DOM (one image, one h1); the other slides are
  inert <template>s that assets/pk-hero.js swaps in.
{%- endcomment -%}

<script type="module" src="{{ 'pk-hero.js' | asset_url }}"></script>

{%- liquid
  assign keys = ''
  for entry in shop.metaobjects.hero_slide.values
    if entry.active.value == true and entry.title.value != blank and entry.desktop_image.value != blank
      assign sort_order = entry.sort_order.value
      if sort_order == blank
        assign sort_order = 999999
      endif
      assign key = sort_order | plus: 1000000 | append: '|' | append: entry.system.handle
      assign keys = keys | append: key | append: ','
    endif
  endfor
  assign cms_keys = keys | split: ',' | sort
  assign cms_count = cms_keys.size

  if cms_count > 0
    assign mode = 'shopify'
    assign count = cms_count
  else
    assign mode = 'fallback'
    assign count = section.blocks.size
  endif
  assign last = count | minus: 1
  assign live_media = ''
  assign live_content = ''
  assign templates = ''
  assign first_title = ''
-%}

{%- if count > 0 -%}
  {%- for n in (0..last) -%}
    {%- liquid
      assign eager = false
      if n == 0
        assign eager = true
      endif
      if mode == 'shopify'
        assign handle = cms_keys[n] | split: '|' | last
        assign entry = shop.metaobjects.hero_slide[handle]
        assign desktop = entry.desktop_image.value
        assign image = desktop | image_url: width: 2400
        capture srcset
          echo desktop | image_url: width: 800
          echo ' 800w, '
          echo desktop | image_url: width: 1200
          echo ' 1200w, '
          echo desktop | image_url: width: 1600
          echo ' 1600w, '
          echo desktop | image_url: width: 2400
          echo ' 2400w'
        endcapture
        assign mobile = entry.mobile_image.value
        assign mobile_image = ''
        assign mobile_srcset = ''
        if mobile != blank
          assign mobile_image = mobile | image_url: width: 1200
          capture mobile_srcset
            echo mobile | image_url: width: 600
            echo ' 600w, '
            echo mobile | image_url: width: 900
            echo ' 900w, '
            echo mobile | image_url: width: 1200
            echo ' 1200w'
          endcapture
        endif
        assign alt = desktop.alt
        assign width = desktop.width
        assign height = desktop.height
        assign pos_sm = ''
        assign pos_md = ''
        assign pos_lg = ''
        assign overline = entry.overline.value
        assign title = entry.title.value
        assign body = entry.subtitle.value
        assign cta_label = entry.cta_label.value
        assign cta_url = entry.cta_url.value
      else
        assign block = section.blocks[n]
        if block.settings.image != blank
          assign image = block.settings.image | image_url: width: 2400
        else
          assign image = block.settings.image_url
        endif
        assign srcset = ''
        assign mobile_image = ''
        assign mobile_srcset = ''
        assign alt = block.settings.title
        assign width = block.settings.image.width | default: 1800
        assign height = block.settings.image.height | default: 2700
        assign pos_sm = block.settings.mobile_position
        assign pos_md = block.settings.tablet_position
        assign pos_lg = block.settings.desktop_position
        assign overline = block.settings.overline
        assign title = block.settings.title
        assign body = block.settings.body
        assign cta_label = block.settings.cta_label
        assign cta_url = block.settings.cta_url
      endif
      if n == 0
        assign first_title = title
      endif
    -%}
    {%- capture media -%}
      {%- render 'pk-hero-slide', part: 'media', image: image, width: width, height: height, srcset: srcset, mobile_image: mobile_image, mobile_srcset: mobile_srcset, alt: alt, pos_sm: pos_sm, pos_md: pos_md, pos_lg: pos_lg, title: title, index: n, count: count, eager: eager -%}
    {%- endcapture -%}
    {%- capture content -%}
      {%- render 'pk-hero-slide', part: 'content', overline: overline, title: title, body: body, cta_label: cta_label, cta_url: cta_url, index: n, count: count -%}
    {%- endcapture -%}
    {%- if n == 0 -%}
      {%- assign live_media = media -%}
      {%- assign live_content = content -%}
    {%- endif -%}
    {%- capture template -%}
      <template data-pk-slide="{{ n }}" data-title="{{ title | escape }}">{{ media }}{{ content }}</template>
    {%- endcapture -%}
    {%- assign templates = templates | append: template -%}
  {%- endfor -%}

  <pk-hero data-count="{{ count }}" data-mode="{{ mode }}">
    <section
      class="pk-hero"
      aria-roledescription="carousel"
      aria-label="Featured"
      data-testid="hero-carousel"
    >
      <div class="pk-hero__media" data-pk-hero-media>{{ live_media }}</div>
      <div class="pk-hero__overlay pk-hero__overlay--bottom"></div>
      <div class="pk-hero__overlay pk-hero__overlay--left"></div>
      <div class="pk-hero__overlay pk-hero__overlay--corner"></div>

      <div class="pk-container pk-hero__content">
        <div class="pk-hero__column">
          <div class="pk-hero__text" data-pk-hero-text>{{ live_content }}</div>
          {%- if count > 1 -%}
            <div class="pk-hero__controls" data-testid="hero-controls">
              <div class="pk-hero__meta">
                <span aria-hidden="true" data-pk-hero-counter data-testid="hero-counter">01 / {{ count | prepend: '0' | slice: -2, 2 }}</span>
                <span class="pk-hero__track" aria-hidden="true">
                  <span class="pk-hero__bar" data-pk-hero-bar data-testid="hero-progress" style="transform: scaleX(0)"></span>
                </span>
              </div>
              <div class="pk-hero__buttons">
                <button type="button" class="pk-hero__button" data-pk-hero-pause aria-label="Pause slideshow" data-testid="hero-pause">
                  <svg class="pk-hero__icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
                  <svg class="pk-hero__icon-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden><path d="M6 3l14 9-14 9V3z"/></svg>
                </button>
                <button type="button" class="pk-hero__button" data-pk-hero-prev aria-label="Previous slide" data-testid="hero-prev">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button type="button" class="pk-hero__button" data-pk-hero-next aria-label="Next slide" data-testid="hero-next">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <p class="pk-visually-hidden" aria-live="off" aria-atomic="true" data-pk-hero-live>Slide 1 of {{ count }}: {{ first_title | escape }}</p>
      {{ templates }}
    </section>
  </pk-hero>
{%- endif -%}

{% stylesheet %}
  pk-hero {
    display: block;
  }

  /* Height: 4:5 box capped at 65% of the screen below 1024px; 70vh from 1024px (production P2h-A) */
  .pk-hero {
    position: relative;
    width: 100%;
    height: min(125vw, 65svh);
    min-height: 420px;
    overflow: hidden;
    touch-action: pan-y;
    background: #2a0b13;
  }

  .pk-hero__media,
  .pk-hero__picture,
  .pk-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .pk-hero__picture {
    display: block;
  }

  .pk-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pk-pos-sm, 50% 50%);
  }

  /* Below 1024px: darken from the bottom where the text sits (P2h-A lightest passing overlay) */
  .pk-hero__overlay--bottom {
    background: linear-gradient(
      to top,
      rgb(42 11 19 / 0.7) 0%,
      rgb(42 11 19 / 0.64) 40%,
      rgb(42 11 19 / 0.7) 64%,
      rgb(42 11 19 / 0.22) 78%,
      rgb(42 11 19 / 0) 90%
    );
  }

  .pk-hero__overlay--left,
  .pk-hero__overlay--corner {
    display: none;
  }

  .pk-hero__content {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding-bottom: 0.75rem;
  }

  .pk-hero__column {
    width: 100%;
  }

  .pk-hero__slide {
    color: var(--pk-ivory);
  }

  .pk-hero__overline {
    margin: 0;
    color: #fde087;
  }

  .pk-hero__title {
    display: -webkit-box;
    margin: 0.75rem 0 0;
    overflow: hidden;
    font-size: clamp(1.625rem, 7vw, 2rem);
    line-height: 1.1;
    color: var(--pk-ivory);
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .pk-hero__body {
    display: -webkit-box;
    max-width: 28rem;
    margin: 0.75rem 0 0;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.625;
    color: #ead7dc;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .pk-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    max-width: 100%;
    min-width: 180px;
    height: 3rem;
    margin-top: 1.25rem;
    padding: 0 1.75rem;
    background: var(--pk-ivory);
    color: var(--pk-maroon);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .pk-hero__cta:hover {
    background: var(--pk-gold-soft);
  }

  .pk-hero__cta:active {
    background: var(--pk-maroon);
    color: var(--pk-ivory);
  }

  .pk-hero__cta-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pk-hero__cta-arrow {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .pk-hero__cta:hover .pk-hero__cta-arrow {
    transform: translateX(2px);
  }

  .pk-hero__cta:focus-visible,
  .pk-hero__button:focus-visible {
    outline: 2px solid var(--pk-ivory);
    outline-offset: 2px;
  }

  .pk-hero__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 0.75rem;
  }

  .pk-hero__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.6875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
    color: rgb(255 255 255 / 0.85);
  }

  .pk-hero__track {
    position: relative;
    display: block;
    width: 3rem;
    height: 1px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.3);
  }

  .pk-hero__bar {
    position: absolute;
    inset: 0;
    transform-origin: left;
    background: var(--pk-gold-soft);
  }

  .pk-hero__buttons {
    display: flex;
    align-items: center;
    margin-right: -0.75rem;
  }

  .pk-hero__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.8);
    cursor: pointer;
    transition: color 0.2s;
  }

  .pk-hero__button:hover {
    color: var(--pk-white);
  }

  .pk-hero__button svg {
    width: 1rem;
    height: 1rem;
  }

  .pk-hero__button[data-pk-hero-pause] svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* Horizon's base CSS sets svg { display: block }, which overrides [hidden] */
  .pk-hero__button svg[hidden] {
    display: none;
  }

  @media (min-width: 640px) {
    .pk-hero__body {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 768px) {
    .pk-hero__image {
      object-position: var(--pk-pos-md, var(--pk-pos-sm, 50% 50%));
    }

    .pk-hero__content {
      padding-bottom: 1.5rem;
    }

    .pk-hero__column {
      max-width: 36rem;
    }

    .pk-hero__title {
      font-size: 40px;
    }
  }

  @media (min-width: 1024px) {
    .pk-hero {
      height: 70vh;
      min-height: 440px;
    }

    .pk-hero__image {
      object-position: var(--pk-pos-lg, 50% 50%);
    }

    .pk-hero__overlay--bottom {
      display: none;
    }

    .pk-hero__overlay--left {
      display: block;
      background: linear-gradient(
        to right,
        rgb(42 11 19 / 0.85) 0%,
        rgb(42 11 19 / 0.68) 35%,
        rgb(42 11 19 / 0.4) 55%,
        rgb(42 11 19 / 0.08) 75%,
        rgb(42 11 19 / 0) 100%
      );
    }

    .pk-hero__overlay--corner {
      display: block;
      background: radial-gradient(75% 70% at 100% 100%, rgb(42 11 19 / 0.88) 0%, rgb(42 11 19 / 0) 100%);
    }

    .pk-hero__content {
      align-items: center;
      padding-bottom: 0;
    }

    .pk-hero__column {
      max-width: 40rem;
    }

    .pk-hero__title {
      max-width: 12em;
      margin-top: 1.25rem;
      font-size: 52px;
      line-height: 1.08;
      -webkit-line-clamp: 4;
    }

    .pk-hero__body {
      margin-top: 1.25rem;
      font-size: 1rem;
      -webkit-line-clamp: 3;
    }

    .pk-hero__cta {
      margin-top: 2rem;
    }

    .pk-hero__controls {
      position: absolute;
      right: 2rem;
      bottom: 1rem;
      gap: 1rem;
      width: auto;
      margin-top: 0;
    }

    .pk-hero__track {
      width: 4rem;
    }

    .pk-hero__buttons {
      margin-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PK hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Slides come from Content → Metaobjects → Hero Slide (active entries, ordered by sort order). The fallback slides below show only while there are no active Hero Slide entries."
    }
  ],
  "blocks": [
    {
      "type": "fallback_slide",
      "name": "Fallback slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "image_url", "label": "Image URL (used when no image is picked)" },
        { "type": "text", "id": "mobile_position", "label": "Crop below 768px (object-position)", "default": "50% 50%" },
        { "type": "text", "id": "tablet_position", "label": "Crop 768–1023px (object-position)" },
        { "type": "text", "id": "desktop_position", "label": "Crop from 1024px (object-position)", "default": "50% 50%" },
        { "type": "text", "id": "overline", "label": "Overline" },
        { "type": "text", "id": "title", "label": "Title", "default": "Slide title" },
        { "type": "textarea", "id": "body", "label": "Text" },
        { "type": "text", "id": "cta_label", "label": "Button label" },
        { "type": "text", "id": "cta_url", "label": "Button link (a site path such as /collections/all, or https://…)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "PK hero" }]
}
{% endschema %}
