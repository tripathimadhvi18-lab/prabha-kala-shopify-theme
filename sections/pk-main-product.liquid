{%- comment -%}
  Prabha Kala product page (Phase 4B).

  Everything shown comes from Shopify: media, title, variant prices, compare-at price,
  inventory, description and the custom.fabric / occasion / color / wash_care metafields
  (each shown only when it has a value; craft is intentionally not shown).
  The buy form is Shopify's native product form, so Add to bag works without JavaScript;
  pk-product.js enhances it (variant switching, quantity, cart drawer via the same flow as
  the product card, swipe gallery, larger-image viewer, sticky mobile bar).
{%- endcomment -%}

{{ 'pk-product.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'pk-product-card.js' | asset_url }}"></script>
<script type="module" src="{{ 'pk-product.js' | asset_url }}"></script>
<script type="module">
  import '@theme/view-event-elements';
</script>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign price = variant.price
  assign compare = variant.compare_at_price | default: 0
  assign form_id = 'PkProductForm-' | append: section.id
  assign media_count = product.media.size

  assign stock = null
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    assign stock = variant.inventory_quantity
  endif

  assign fabric = product.metafields.custom.fabric.value
  assign occasion = product.metafields.custom.occasion.value
  assign color = product.metafields.custom.color.value
  assign wash_care = product.metafields.custom.wash_care.value
  assign has_details = false
  if fabric != blank or occasion != blank or color != blank or wash_care != blank
    assign has_details = true
  endif

  assign first_media = product.featured_media
  assign ratio = first_media.preview_image.aspect_ratio | default: 0.6667
  if ratio < 0.5
    assign ratio = 0.5
  elsif ratio > 1.25
    assign ratio = 1.25
  endif
-%}

{% # theme-check-disable-next-line UnknownFilter %}
<product-component view-event-payload="{{ product | standard_event_data: 'view' | escape }}">
<pk-product
  class="pk-product"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-cart-module="{{ 'pk-product-card.js' | asset_url }}"
  data-testid="pk-product"
>
  <div class="pk-container">
    <nav class="pk-product__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="pk-focus">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}" class="pk-focus">{{ section.settings.crumb_label | escape }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="pk-product__layout">
      {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
      <div
        class="pk-gallery{% if media_count > 1 %} pk-gallery--multi{% endif %}"
        style="--pk-ratio: {{ ratio }};"
        data-pk-gallery
        data-testid="pdp-gallery"
      >
        {%- if media_count > 0 -%}
          <div class="pk-gallery__stage">
            <ul
              class="pk-gallery__track"
              data-pk-gallery-track
              {% if media_count > 1 %}tabindex="0" aria-label="Product images, {{ media_count }} in total. Use arrow keys or swipe to move between them."{% else %}aria-label="Product image"{% endif %}
            >
              {%- for media in product.media -%}
                {%- liquid
                  assign alt = media.alt | default: product.title
                  assign loading = 'lazy'
                  assign priority = 'auto'
                  if forloop.first
                    assign loading = 'eager'
                    assign priority = 'high'
                  endif
                -%}
                <li class="pk-gallery__slide" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                  {%- if media.media_type == 'image' -%}
                    <button
                      type="button"
                      class="pk-gallery__zoom pk-focus"
                      data-pk-zoom="{{ forloop.index0 }}"
                      aria-label="View image {{ forloop.index }} of {{ media_count }} larger"
                    >
                      {{-
                        media.preview_image
                        | image_url: width: 1400
                        | image_tag:
                          widths: '375,550,750,1000,1400',
                          sizes: '(min-width: 1024px) 48vw, 100vw',
                          loading: loading,
                          fetchpriority: priority,
                          alt: alt,
                          class: 'pk-gallery__image',
                          data-testid: 'pdp-image'
                      -}}
                    </button>
                  {%- else -%}
                    <div class="pk-gallery__media">
                      {{- media | media_tag: image_size: '1400x', autoplay: false, loop: false, controls: true -}}
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if media_count > 1 -%}
              <button type="button" class="pk-gallery__arrow pk-gallery__arrow--prev pk-focus" data-pk-gallery-step="-1" aria-label="Previous image">
                {%- render 'pk-icon', name: 'chevron-left' -%}
              </button>
              <button type="button" class="pk-gallery__arrow pk-gallery__arrow--next pk-focus" data-pk-gallery-step="1" aria-label="Next image">
                {%- render 'pk-icon', name: 'chevron-right' -%}
              </button>
              <p class="pk-gallery__counter" aria-hidden="true"><span data-pk-gallery-current>1</span> / {{ media_count }}</p>
            {%- endif -%}
          </div>

          {%- if media_count > 1 -%}
            <ul class="pk-gallery__thumbs" aria-label="Choose an image">
              {%- for media in product.media -%}
                <li>
                  <button
                    type="button"
                    class="pk-gallery__thumb pk-focus"
                    data-pk-gallery-thumb="{{ forloop.index0 }}"
                    aria-label="Show image {{ forloop.index }} of {{ media_count }}"
                    {% if forloop.first %}aria-current="true"{% endif %}
                    data-testid="pdp-thumb-{{ forloop.index0 }}"
                  >
                    {{- media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'pk-gallery__thumb-image', sizes: '80px', widths: '80,160' -}}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- else -%}
          <div class="pk-gallery__stage pk-gallery__stage--empty">
            {{- 'product-apparel-1' | placeholder_svg_tag: 'pk-gallery__placeholder' -}}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
      <div class="pk-product__info">
        {%- if section.settings.show_fabric_overline and fabric != blank -%}
          <p class="pk-overline pk-product__overline">{{ fabric | escape }}</p>
        {%- endif -%}
        <h1 class="pk-product__title pk-heading" data-testid="pdp-title">{{ product.title | escape }}</h1>

        <div class="pk-product__price" data-testid="pdp-price-block">
          <span class="pk-product__price-now" data-pk-price data-testid="pdp-price">{%- render 'pk-price', amount: price -%}</span>
          <span class="pk-product__price-was" data-pk-compare {% unless compare > price %}hidden{% endunless %}>
            <span class="pk-visually-hidden">Regular price</span>
            <s data-pk-compare-value>{%- if compare > price -%}{%- render 'pk-price', amount: compare -%}{%- endif -%}</s>
          </span>
          <span class="pk-product__save" data-pk-save {% unless compare > price %}hidden{% endunless %}>
            {%- if compare > price -%}{%- assign saving = compare | minus: price -%}Save {% render 'pk-price', amount: saving %}{%- endif -%}
          </span>
        </div>
        {%- if section.settings.price_note != blank -%}
          <p class="pk-product__price-note">{{ section.settings.price_note | escape }}</p>
        {%- endif -%}

        <p class="pk-product__stock" data-pk-stock role="status" data-testid="pdp-stock">
          {%- if variant.available == false -%}
            Sold out
          {%- elsif stock != null and stock > 0 and stock <= 3 -%}
            Only {{ stock }} left
          {%- endif -%}
        </p>

        {%- unless product.has_only_default_variant -%}
          <div class="pk-product__options">
            {%- for option in product.options_with_values -%}
              <fieldset class="pk-option" data-pk-option="{{ forloop.index0 }}">
                <legend class="pk-option__legend">
                  <span class="pk-overline">{{ option.name | escape }}</span>
                  <span class="pk-option__selected" data-pk-option-selected>{{ option.selected_value | escape }}</span>
                </legend>
                <div class="pk-option__values">
                  {%- for value in option.values -%}
                    <label class="pk-option__value">
                      <input
                        type="radio"
                        class="pk-option__input"
                        name="PkOption-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                        value="{{ value | escape }}"
                        form="PkNoSubmit-{{ section.id }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      <span class="pk-option__pill pk-focus">{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- form 'product', product, id: form_id, class: 'pk-product__form', data-pk-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ variant.id }}" data-pk-variant-id>
          <div class="pk-product__buy">
            {%- if section.settings.show_quantity -%}
              <div class="pk-qty" data-pk-qty>
                <label class="pk-visually-hidden" for="PkQty-{{ section.id }}">Quantity</label>
                <button type="button" class="pk-qty__step pk-focus" data-pk-qty-step="-1" aria-label="Decrease quantity" disabled>
                  <span aria-hidden="true">−</span>
                </button>
                <input
                  type="number"
                  class="pk-qty__input"
                  id="PkQty-{{ section.id }}"
                  name="quantity"
                  value="1"
                  min="1"
                  {% if stock != null and stock > 0 %}max="{{ stock }}"{% endif %}
                  step="1"
                  inputmode="numeric"
                  data-testid="pdp-qty"
                  {% unless variant.available %}disabled{% endunless %}
                >
                <button
                  type="button"
                  class="pk-qty__step pk-focus"
                  data-pk-qty-step="1"
                  aria-label="Increase quantity"
                  {% if variant.available == false or stock != null and stock <= 1 %}disabled{% endif %}
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
            {%- endif -%}
            <button
              type="submit"
              name="add"
              class="pk-button pk-button--primary pk-product__add"
              data-pk-add
              data-testid="pdp-add-to-bag"
              {% unless variant.available %}disabled{% endunless %}
            >
              <span data-pk-add-label>{% if variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
            </button>
          </div>
          {%- if section.settings.show_buy_now -%}
            <div class="pk-product__buy-now" data-pk-buy-now>{{ form | payment_button }}</div>
          {%- endif -%}
          <p class="pk-product__error" data-pk-error role="alert" hidden></p>
        {%- endform -%}

        {%- if has_details -%}
          <div class="pk-product__details" data-testid="pdp-details">
            <p class="pk-overline">The details</p>
            <dl class="pk-specs">
              {%- if fabric != blank -%}
                <div class="pk-specs__row" data-testid="pdp-spec-fabric"><dt>Fabric</dt><dd>{{ fabric | escape }}</dd></div>
              {%- endif -%}
              {%- if occasion != blank -%}
                <div class="pk-specs__row" data-testid="pdp-spec-occasion"><dt>Occasion</dt><dd>{{ occasion | escape }}</dd></div>
              {%- endif -%}
              {%- if color != blank -%}
                <div class="pk-specs__row" data-testid="pdp-spec-color"><dt>Colour</dt><dd>{{ color | escape }}</dd></div>
              {%- endif -%}
              {%- if wash_care != blank -%}
                <div class="pk-specs__row" data-testid="pdp-spec-wash-care"><dt>Wash care</dt><dd>{{ wash_care | escape }}</dd></div>
              {%- endif -%}
            </dl>
          </div>
        {%- endif -%}

        <div class="pk-accordions">
          {%- if product.description != blank -%}
            <details class="pk-accordion" open data-testid="pdp-description">
              <summary class="pk-accordion__summary pk-focus">
                <span class="pk-heading">Description</span>
                {%- render 'pk-icon', name: 'chevron-down', class: 'pk-accordion__chevron' -%}
              </summary>
              <div class="pk-accordion__body pk-rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.shipping_text != blank -%}
            <details class="pk-accordion" data-testid="pdp-shipping">
              <summary class="pk-accordion__summary pk-focus">
                <span class="pk-heading">{{ section.settings.shipping_heading | escape }}</span>
                {%- render 'pk-icon', name: 'chevron-down', class: 'pk-accordion__chevron' -%}
              </summary>
              <div class="pk-accordion__body pk-rte">{{ section.settings.shipping_text }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Sticky bar below 1024px, shown once the main button scrolls away. {%- endcomment -%}
  <div class="pk-sticky" data-pk-sticky hidden data-testid="pdp-sticky-cta">
    <div class="pk-sticky__text">
      <p class="pk-sticky__title">{{ product.title | escape }}</p>
      <p class="pk-sticky__price" data-pk-sticky-price>{%- render 'pk-price', amount: price -%}</p>
    </div>
    <button
      type="submit"
      form="{{ form_id }}"
      name="add"
      class="pk-button pk-button--primary pk-sticky__add"
      data-pk-sticky-add
      data-testid="pdp-sticky-add-to-bag"
      {% unless variant.available %}disabled{% endunless %}
    >
      {% if variant.available %}Add to bag{% else %}Sold out{% endif %}
    </button>
  </div>

  {%- comment -%} Larger-image viewer (native dialog: focus trapping and Escape come for free). {%- endcomment -%}
  {%- if media_count > 0 -%}
    <dialog class="pk-lightbox" data-pk-lightbox aria-label="{{ product.title | escape }} images">
      <button type="button" class="pk-lightbox__close pk-focus" data-pk-lightbox-close aria-label="Close larger images">
        {%- render 'pk-icon', name: 'close' -%}
      </button>
      <ul class="pk-lightbox__list">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <li class="pk-lightbox__item" data-pk-lightbox-item="{{ forloop.index0 }}">
              {{-
                media.preview_image
                | image_url: width: 2400
                | image_tag:
                  widths: '1000,1600,2400',
                  sizes: '100vw',
                  loading: 'lazy',
                  alt: media.alt | default: product.title,
                  class: 'pk-lightbox__image'
              -}}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </dialog>
  {%- endif -%}

  <script type="application/json" data-pk-variants>
    [
      {%- for v in product.variants -%}
        {%- liquid
          assign v_stock = 'null'
          if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
            assign v_stock = v.inventory_quantity
          endif
        -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available }},
          "price": {{ v.price }},
          "compare": {{ v.compare_at_price | default: 0 }},
          "media": {{ v.featured_media.id | default: 'null' }},
          "stock": {{ v_stock }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</pk-product>
</product-component>

{% schema %}
{
  "name": "PK Product",
  "tag": "section",
  "class": "pk-product-section",
  "settings": [
    { "type": "text", "id": "crumb_label", "label": "Breadcrumb collection label", "default": "All sarees" },
    { "type": "checkbox", "id": "show_fabric_overline", "label": "Show fabric above the title", "default": true },
    {
      "type": "text",
      "id": "price_note",
      "label": "Note under the price",
      "info": "Only state what checkout actually does.",
      "default": "Inclusive of GST · ₹99 shipping across India"
    },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show Shopify's Buy it now button",
      "info": "Shopify's accelerated checkout. Off by default: Add to bag and the cart drawer are the Prabha Kala checkout path.",
      "default": false
    },
    { "type": "text", "id": "shipping_heading", "label": "Shipping panel heading", "default": "Shipping & tax" },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping panel text",
      "default": "<p>Prices include GST. Shipping is a flat ₹99 anywhere in India and is added at checkout.</p>"
    }
  ]
}
{% endschema %}
